{
  "manifest_version": 3,
  "name": "拾页 · 浏览器资料同步",
  "version": "0.3.4",
  "description": "同步书签、标签组和七天历史到拾页，保留浏览器默认新标签页。",
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://wo.bohanrich.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开拾页同步设置",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}